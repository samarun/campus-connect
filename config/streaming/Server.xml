<?xml version="1.0" encoding="UTF-8"?>
<Server version="8">
  <Name>Campus Connect Streaming Relay</Name>
  <Type>origin</Type>
  <IP>*</IP>
  <PrivacyProtection>true</PrivacyProtection>
  <StunServer>stun.l.google.com:19302</StunServer>

  <Modules>
    <HTTP2>
      <Enable>true</Enable>
    </HTTP2>
    <LLHLS>
      <Enable>true</Enable>
    </LLHLS>
    <P2P>
      <Enable>false</Enable>
    </P2P>
  </Modules>

  <Bind>
    <Providers>
      <RTMP>
        <Port>1935</Port>
        <WorkerCount>2</WorkerCount>
      </RTMP>
      <SRT>
        <Port>9999</Port>
        <WorkerCount>2</WorkerCount>
        <ThreadPerSocket>true</ThreadPerSocket>
      </SRT>
      <WebRTC>
        <Signalling>
          <Port>3333</Port>
          <TLSPort>3334</TLSPort>
          <WorkerCount>2</WorkerCount>
        </Signalling>
        <IceCandidates>
          <IceCandidate>${PUBLIC_IP}:10000-10003/udp</IceCandidate>
          <IceCandidate>${PUBLIC_IP}:10000/tcp</IceCandidate>
          <TcpRelay>${PUBLIC_IP}:3478</TcpRelay>
        </IceCandidates>
      </WebRTC>
    </Providers>

    <Publishers>
      <LLHLS>
        <Port>3333</Port>
        <TLSPort>3334</TLSPort>
        <WorkerCount>4</WorkerCount>
      </LLHLS>
      <WebRTC>
        <Signalling>
          <Port>3333</Port>
          <TLSPort>3334</TLSPort>
          <WorkerCount>2</WorkerCount>
        </Signalling>
        <IceCandidates>
          <IceCandidate>${PUBLIC_IP}:10000-10003/udp</IceCandidate>
          <IceCandidate>${PUBLIC_IP}:10000/tcp</IceCandidate>
          <TcpRelay>${PUBLIC_IP}:3478</TcpRelay>
        </IceCandidates>
      </WebRTC>
    </Publishers>
  </Bind>

  <VirtualHosts>
    <VirtualHost>
      <Name>default</Name>
      <Distribution>campus-connect</Distribution>
      <Host>
        <Names>
          <Name>*</Name>
        </Names>
      </Host>
      <Applications>
        <Application>
          <Name>broadcast</Name>
          <Type>live</Type>
          <OutputProfiles>
            <Decodes>
              <ThreadCount>2</ThreadCount>
              <OnlyKeyframes>false</OnlyKeyframes>
            </Decodes>
            <OutputProfile>
              <Name>broadcast_adaptive</Name>
              <OutputStreamName>${OriginStreamName}</OutputStreamName>
              <Playlist>
                <Name>adaptive_llhls</Name>
                <FileName>llhls</FileName>
                <Options>
                  <WebRtcAutoAbr>true</WebRtcAutoAbr>
                  <EnableTsPackaging>true</EnableTsPackaging>
                </Options>
                <Rendition>
                  <Name>Source</Name>
                  <Video>video_source</Video>
                  <Audio>audio_source</Audio>
                </Rendition>
                <Rendition>
                  <Name>720p</Name>
                  <Video>video_720p</Video>
                  <Audio>audio_source</Audio>
                </Rendition>
                <Rendition>
                  <Name>480p</Name>
                  <Video>video_480p</Video>
                  <Audio>audio_source</Audio>
                </Rendition>
              </Playlist>
              <Encodes>
                <Audio>
                  <Name>audio_source</Name>
                  <Bypass>true</Bypass>
                </Audio>
                <Video>
                  <Name>video_source</Name>
                  <Bypass>true</Bypass>
                </Video>
                <Video>
                  <Name>video_720p</Name>
                  <Codec>h264</Codec>
                  <Profile>high</Profile>
                  <Bitrate>2500000</Bitrate>
                  <Framerate>30</Framerate>
                  <Width>1280</Width>
                  <Height>720</Height>
                  <KeyFrameInterval>60</KeyFrameInterval>
                  <Preset>faster</Preset>
                  <BFrames>0</BFrames>
                  <ThreadCount>4</ThreadCount>
                </Video>
                <Video>
                  <Name>video_480p</Name>
                  <Codec>h264</Codec>
                  <Profile>main</Profile>
                  <Bitrate>1000000</Bitrate>
                  <Framerate>30</Framerate>
                  <Width>854</Width>
                  <Height>480</Height>
                  <KeyFrameInterval>60</KeyFrameInterval>
                  <Preset>faster</Preset>
                  <BFrames>0</BFrames>
                  <ThreadCount>2</ThreadCount>
                </Video>
              </Encodes>
            </OutputProfile>
          </OutputProfiles>
          <Providers>
            <RTMP />
            <SRT />
            <WebRTC>
              <Timeout>30000</Timeout>
            </WebRTC>
          </Providers>
          <Publishers>
            <AppWorkerCount>2</AppWorkerCount>
            <StreamWorkerCount>8</StreamWorkerCount>
            <LLHLS>
              <ChunkDuration>0.2</ChunkDuration>
              <SegmentDuration>4</SegmentDuration>
              <SegmentCount>6</SegmentCount>
              <CrossDomains>
                <Url>*</Url>
              </CrossDomains>
            </LLHLS>
            <WebRTC>
              <Timeout>30000</Timeout>
              <Rtx>false</Rtx>
              <Ulpfec>false</Ulpfec>
              <JitterBuffer>false</JitterBuffer>
            </WebRTC>
          </Publishers>
        </Application>
      </Applications>
    </VirtualHost>
  </VirtualHosts>
</Server>
