# Campus Connect environment template.
# Copy to .env, replace every CHANGE_ME value, then run ./scripts/deploy.sh.

PUBLIC_IP=CHANGE_ME_ELASTIC_IP

APP_DOMAIN=app.example.com
RTC_DOMAIN=rtc.example.com
TURN_DOMAIN=turn.example.com
STREAM_DOMAIN=stream.example.com
MONITOR_DOMAIN=monitor.example.com
MONITOR_ALLOWED_CIDR=CHANGE_ME_OFFICE_OR_VPN_CIDR

APP_BASE_URL=https://app.example.com
NEXT_PUBLIC_RTC_URL=wss://rtc.example.com
RTC_API_URL=http://host.docker.internal:7880
NEXT_PUBLIC_STREAM_LLHLS_BASE_URL=https://stream.example.com
RELAY_SRT_PUBLISH_URL=srt://stream.example.com:9999?streamid=default/broadcast/program

PLATFORM_NAME='Campus Connect'
ORGANIZATION_NAME='Your Organization'
PRIMARY_SITE_NAME='Primary Site'
REMOTE_SITE_A_NAME='Campus B'
REMOTE_SITE_B_NAME='Campus C'
GREETING_MODE_NAME='Greeting Mode'
PROGRAM_MODE_NAME='Program Mode'

# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_64_BYTE_RANDOM
RTC_API_KEY=CHANGE_ME_RTC_API_KEY
RTC_API_SECRET=CHANGE_ME_RTC_API_SECRET
TURN_STATIC_AUTH_SECRET=CHANGE_ME_TURN_SHARED_SECRET

# Generate role hashes with: npm --prefix campus-connect-web run hash-password -- "your strong password"
ADMIN_PASSWORD_HASH='CHANGE_ME_BCRYPT_HASH'
OPERATOR_PASSWORD_HASH='CHANGE_ME_BCRYPT_HASH'
MAIN_PASSWORD_HASH='CHANGE_ME_BCRYPT_HASH'
CAMPUS_B_PASSWORD_HASH='CHANGE_ME_BCRYPT_HASH'
CAMPUS_C_PASSWORD_HASH='CHANGE_ME_BCRYPT_HASH'

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Production image pins. Update only during a planned maintenance window.
RTC_SERVER_IMAGE=livekit/livekit-server:v1.13.3
RTC_INGRESS_IMAGE=livekit/ingress:v1.5.0
RTC_EGRESS_IMAGE=livekit/egress:v1.13.0
STREAMING_RELAY_IMAGE=ovenmedialabs/ovenmediaengine:v0.20.5
